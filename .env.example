# "local" (IndexedDB, static export) or "supabase" (full backend)
NEXT_PUBLIC_DATA_MODE=local
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server/worker only, never in the client bundle)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by packages/db (migrations, seed)
DATABASE_URL=
# Anthropic API key for the agent runtime
ANTHROPIC_API_KEY=
# Set to 1 to use a scripted fake Anthropic client instead of live calls (tests, CI)
ANTHROPIC_FAKE=
# Postmark server token for transactional email
POSTMARK_SERVER_TOKEN=
# Public product name shown in the UI
NEXT_PUBLIC_APP_NAME=Atlas
